	public static DefaultDirectedGraph<String, DefaultEdge> withWALA(String path) throws IllegalArgumentException, IOException, CancelException,
			WalaException {
		File folder = new File(path);
		File[] files = folder.listFiles();

		ArrayList<File> file_filtered = new ArrayList<File>();

		for (int i = 0; i < files.length; i++) {
			String file_name = files[i].getName();
			if (file_name.endsWith(".js")) {
				//System.out.println("Pre-process: " + file_name);
				file_filtered.add(files[i]);

				/*
				String content = readFromFile(files[i].getAbsolutePath());
				// create a script engine manager
				ScriptEngineManager factory = new ScriptEngineManager();
				// create JavaScript engine
				ScriptEngine engine = factory.getEngineByName("JavaScript");
				// evaluate JavaScript code from given file - specified by first argument
				try {
					engine.eval(content);
				} catch (ScriptException e) {
					e.printStackTrace();
				}
				*/
			}
		}

		SourceFileModule[] scripts = new SourceFileModule[file_filtered.size()];
		for (int i = 0; i < file_filtered.size(); i++) {
			File tmpF = file_filtered.get(i);
			addFuncTrigger(tmpF);
			String file_name = tmpF.getName();
			scripts[i] = new SourceFileModule(tmpF, file_name);
		}

		JSCallGraphUtil.setTranslatorFactory(new CAstRhinoTranslatorFactory());
		CallGraph cg;
		cg = JSCallGraphBuilderUtil.makeScriptCG(scripts, CGBuilderType.ZERO_ONE_CFA, AstIRFactory.makeDefaultFactory());

		return dumpCG(cg);
	}

	public static void buildCFGWithWala(String path) throws IllegalArgumentException, IOException, CancelException, WalaException {
		DefaultDirectedGraph<String, DefaultEdge> g = withWALA(path);

		DOTExporter<String, DefaultEdge> exporter = new DOTExporter<String, DefaultEdge>(new StringNameProvider<String>(),
				new StringNameProvider<String>(), null);
		StringWriter sw = new StringWriter();
		exporter.export(sw, g);

		StaticCGUtil.writeToFile(path + "callgraph_wala.dot", sw.toString(), false);
	}

	public static void main(String[] args) throws IllegalArgumentException, IOException, CancelException, WalaException {
		String path = "C:\\Users\\rzhao\\Downloads\\T1\\cg\\";

		buildCFGWithWala(path);
	}
