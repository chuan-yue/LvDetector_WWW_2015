public class StaticCGWala {

	public static String[] getCGNodeInfo(CGNode node) {
		IClass klass = node.getMethod().getDeclaringClass();
		if (!klass.getName().toString().startsWith("Lprologue.js") && !klass.getName().toString().startsWith("Lpreamble.js")) {
			IMethod m = klass.getMethod(AstMethodReference.fnSelector);
			if (m != null) {
				String func_info = m.getDeclaringClass().getName().toString();
				func_info = func_info.substring(1);
				if (func_info.contains("/")) {
					return func_info.split("/");
				} else {
					return new String[] { func_info, "" };
				}
			}
		}
		return null;
	}

	public static HashMap<Integer, String> parseAllDefinitions(SSAInstruction[] ins, SymbolTable st) {
		HashMap<Integer, String> var_localname_map = new HashMap<Integer, String>();
		for (SSAInstruction in : ins) {
			if (AstGlobalRead.class.isInstance(in)) {
				int def = in.getDef();
				String gName = ((AstGlobalRead) in).getGlobalName();

				if (!gName.contains("__WALA__int3rnal__global") && !gName.contains("$$undefined")) {
					gName = gName.replace("global ", "");
					var_localname_map.put(def, gName.replace("\n", ""));
				}
			}
		}
		return var_localname_map;
	}

	public static DefaultDirectedGraph<String, DefaultEdge> dumpCG(CallGraph cg) {
		/*
		CallGraph2JSON.IGNORE_HARNESS = true;
		Map<String, Set<String>> edges = CallGraph2JSON.extractEdges(cg);
		for (String callsite : edges.keySet()) {
			for (String callee : edges.get(callsite)) {
				System.out.println(callsite + " -> " + callee);
			}
		}
		*/

		DefaultDirectedGraph<String, DefaultEdge> graph = new DefaultDirectedGraph<String, DefaultEdge>(DefaultEdge.class);
		for (CGNode node : cg) {
			String[] caller_info = getCGNodeInfo(node);
			if (null == caller_info) {
				continue;
			}

			IR ir = node.getIR();
			//System.out.println(ir);
			SymbolTable st = ir.getSymbolTable();
			SSAInstruction[] ins = ir.getInstructions();

			HashMap<Integer, String> map = parseAllDefinitions(ins, st);

			Iterator<CallSiteReference> it_callsite = node.iterateCallSites();
			while (it_callsite.hasNext()) {
				// for each callsite
				CallSiteReference callsite = it_callsite.next();

				IntSet is = ir.getCallInstructionIndices(callsite);
				IntIterator it_int = is.intIterator();
				while (it_int.hasNext()) {
					int i = it_int.next();
					SSAInstruction in = ins[i];

					if (!((SSAAbstractInvokeInstruction) in).getCallSite().getDeclaredTarget().equals(JavaScriptMethods.ctorReference)) {
						String callInfo = ir.instructionPosition(i);
						String line_no = callInfo.substring(callInfo.indexOf("line") + 5, callInfo.length() - 1);

						String function_name = null;
						if (((SSAAbstractInvokeInstruction) in).getCallSite().getDeclaredTarget().equals(JavaScriptMethods.dispatchReference)) {
							// method call
							int object_indice = in.getUse(1);
							int method_indice = in.getUse(0);

							String object_name = map.get(Integer.valueOf(object_indice));
							if (null == object_name) {
								Value value = st.getValue(object_indice);
								if (null != value) {
									object_name = value.toString().substring(1);
								} else {
									object_name = ir.getLocalNames(i, object_indice)[0];
								}
							}

							String method_name = map.get(Integer.valueOf(method_indice));
							if (null == method_name) {
								Value value = st.getValue(method_indice);
								if (null != value) {
									method_name = value.toString().substring(1);
								} else {
									method_name = ir.getLocalNames(i, method_indice)[0];
								}
							}

							function_name = object_name + "." + method_name;
						} else {
							// function call
							int function_indice = in.getUse(0);
							function_name = map.get(Integer.valueOf(function_indice));
							if (null == function_name) {
								Value value = st.getValue(function_indice);
								if (null != value) {
									function_name = value.toString().substring(1);
								} else {
									function_name = ir.getLocalNames(i, function_indice)[0];
								}
							}
						}

						Set<CGNode> targets = cg.getPossibleTargets(node, callsite);
						for (CGNode target : targets) {
							String[] callee_info = getCGNodeInfo(target);
							if (null != callee_info) {
								StaticCGUtil.printCall(caller_info, callee_info, new String[] { caller_info[0], caller_info[1], line_no,
										function_name }, graph);
							}
						}
					}
				}
			}
		}
		return graph;
	}

